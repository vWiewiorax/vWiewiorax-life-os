# ===== Supabase (wymagane) =====
# Supabase -> Project Settings -> API (lub `npx supabase status` lokalnie)
NEXT_PUBLIC_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Tylko serwer (cron, przetwarzanie plików). NIGDY nie dodawaj prefiksu NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Adres aplikacji (linki w e-mailach, przekierowania logowania)
APP_URL=http://localhost:3000

# ===== OpenAI (wymagane dla funkcji AI) =====
# platform.openai.com -> API keys. Bez klucza AI jest wyraźnie oznaczone jako nieskonfigurowane.
OPENAI_API_KEY=
# Opcjonalnie: modele
# OPENAI_MODEL=gpt-5-mini
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_BASE_URL=

# ===== Przypomnienia w tle =====
# Dowolny długi losowy ciąg. Cron wywołuje /api/cron/notifications z nagłówkiem Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Web push: wygeneruj `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:twoj@email.pl

# E-mail (SMTP), np. Resend: host smtp.resend.com, port 465, user resend, hasło = API key
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Life OS <przypomnienia@twojadomena.pl>"
